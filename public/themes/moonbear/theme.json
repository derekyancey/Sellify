  "collections": {
    "bundles": { "title": "Bundles", "match": ["bundle"] },
    "color": { "title": "LUTs & Color Filters", "match": ["lut", "color", "colour", "grade", "preset"] },
    "effects": { "title": "Effects", "match": ["effect", "glitch", "blur", "halation", "fx"] },
