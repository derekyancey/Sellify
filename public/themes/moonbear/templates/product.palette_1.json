  {
   "id": "shotclub_proof_BqMFfM",
   "scheme": "scheme-1",
   "type": "custom",
   "name": "shotclub_proof",
   "html": "<section class=\"shopify-section sc-proof-section\" id=\"shopify-section-template--23137861107955__shotclub_proof_BqMFfM\"><style data-shopify=\"\">\n  .sc-proof {\n    background: rgba(247, 247, 248, 0.4);\n    border-bottom: 1px solid #eeeef1;\n    padding: 40px 20px 64px;\n    color: #0e0e14;\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n  .sc-proof__inner {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n  .sc-proof__head {\n    text-align: center;\n    max-width: 560px;\n    margin: 0 auto;\n  }\n  .sc-proof__rule {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #60606e;\n    font-weight: 500;\n  }\n  .sc-proof__rule-line {\n    width: 24px;\n    height: 1px;\n    background: #b6b6c2;\n    display: inline-block;\n  }\n  .sc-proof__title {\n    margin: 16px 0 0;\n    font-size: 26px;\n    line-height: 1.1;\n    letter-spacing: -0.012em;\n    font-weight: 500;\n    color: #0e0e14;\n  }\n  .sc-proof__title em {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-weight: 400;\n    color: #60606e;\n  }\n  .sc-proof__sub {\n    margin: 12px auto 0;\n    font-size: 14px;\n    line-height: 1.55;\n    color: #60606e;\n    max-width: 480px;\n  }\n  .sc-proof__grid {\n    margin: 36px auto 0;\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 8px;\n    max-width: 960px;\n  }\n  .sc-proof__cell {\n    overflow: hidden;\n    border-radius: 16px;\n    background: #eeeef1;\n    aspect-ratio: 4 / 5;\n    position: relative;\n  }\n  .sc-proof__cell img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);\n  }\n  .sc-proof__cell:hover img {\n    transform: scale(1.04);\n  }\n  @media (min-width: 640px) {\n    .sc-proof__grid { gap: 12px; grid-template-columns: repeat(3, 1fr); }\n    .sc-proof__title { font-size: 32px; }\n    .sc-proof__sub { font-size: 16px; }\n  }\n  @media (min-width: 900px) {\n    .sc-proof__title { font-size: 40px; }\n    .sc-proof__grid { grid-template-columns: repeat(4, 1fr); }\n  }\n</style>\n<section class=\"sc-proof\">\n<div class=\"sc-proof__inner\">\n<div class=\"sc-proof__head\">\n<div class=\"sc-proof__rule\">\n<span class=\"sc-proof__rule-line\"></span>\n<span>Behind the door</span>\n<span class=\"sc-proof__rule-line\"></span>\n</div>\n<h2 class=\"sc-proof__title\">\n        A live sample\n        <em>from the floor.</em>\n</h2>\n<p class=\"sc-proof__sub\">\n        Film-like solid color backgrounds.\n      </p>\n</div>\n<div class=\"sc-proof__grid\"></div>\n</div>\n</section>\n</section>"
