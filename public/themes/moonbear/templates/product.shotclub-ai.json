      "css": "\n  .ai-image-gallery-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    width: 100%;\n    padding: 40px 0;\n  }\n\n  .ai-image-gallery__container-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 20px;\n  }\n\n  .ai-image-gallery__grid-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 16px;\n    margin-top: 24px;\n  }\n\n  .ai-image-gallery__title-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    text-align: center;\n    color: #000000;\n    font-size: 32px;\n    margin: 0;\n  }\n\n  .ai-image-gallery__item-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    position: relative;\n    overflow: hidden;\n    border-radius: 8px;\n    background-color: #f4f4f4;\n    aspect-ratio: 16/9;\n  }\n\n  .ai-image-gallery__image-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    transition: transform 0.3s ease;\n  }\n\n  .ai-image-gallery__placeholder-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    background-color: #f4f4f4;\n    position: relative;\n  }\n\n  .ai-image-gallery__placeholder-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 svg {\n    width: 60%;\n    height: 60%;\n    opacity: 0.3;\n  }\n\n  .ai-image-gallery__empty-state-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    position: absolute;\n    bottom: 10px;\n    left: 50%;\n    transform: translateX(-50%);\n    font-size: 12px;\n    color: #666;\n    text-align: center;\n    pointer-events: none;\n  }\n\n  \n    .ai-image-gallery__item-atvbeqm45owlemfh0laigenblockf4be74ehyngm4:hover .ai-image-gallery__image-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n      transform: scale(1.05);\n    }\n  \n\n  .ai-image-gallery__overlay-atvbeqm45owlemfh0laigenblockf4be74ehyngm4 {\n    position: absolute;\n    top: 0;\n    left: 0;\n   