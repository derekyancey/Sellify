  {
   "id": "shotclub_house_rules_DAKzyH",
   "scheme": "scheme-1",
   "type": "custom",
   "name": "shotclub_house_rules",
   "html": "<section class=\"shopify-section sc-rules-section\" id=\"shopify-section-template--23043659989235__shotclub_house_rules_DAKzyH\"><style data-shopify=\"\">\n  .sc-rules {\n    padding: 64px 20px 80px;\n    color: #f7f7f8;\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n  .sc-rules__inner {\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n  .sc-rules__card {\n    position: relative;\n    overflow: hidden;\n    background: #07070b;\n    color: #eeeef1;\n    border-radius: 28px;\n    padding: 48px 24px;\n  }\n  .sc-rules__halo {\n    pointer-events: none;\n    position: absolute;\n    top: -120px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 680px;\n    height: 420px;\n    border-radius: 9999px;\n    background: rgba(252, 211, 77, 0.18);\n    filter: blur(80px);\n  }\n  .sc-rules__head {\n    position: relative;\n    max-width: 720px;\n  }\n  .sc-rules__rule {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #b6b6c2;\n    font-weight: 500;\n  }\n  .sc-rules__rule-line {\n    width: 24px;\n    height: 1px;\n    background: #2e2e38;\n    display: inline-block;\n  }\n  .sc-rules__title {\n    margin: 16px 0 0;\n    font-size: 28px;\n    line-height: 1.06;\n    letter-spacing: -0.012em;\n    font-weight: 500;\n    color: #ffffff;\n  }\n  .sc-rules__title em {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-weight: 400;\n    color: #b6b6c2;\n  }\n  .sc-rules__grid {\n    margin-top: 36px;\n    display: grid;\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n  .sc-rule {\n    border-top: 1px solid #1c1c24;\n    padding-top: 16px;\n  }\n  .sc-rule__head {\n    display: flex;\n    align-items: baseline;\n    gap: 12px;\n  }\n  .sc-rule__num {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    color: #60606e;\n    font-size: 22px;\n    line-height: 1;\n  }\n  .sc-rule__title {\n    margin: 0;\n    color: #ffffff;\n    font-size: 17px;\n    line-height: 1.2;\n    letter-spacing: -0.012em;\n    font-weight: 500;\n  }\n  .sc-rule__body {\n    margin: 12px 0 0 36px;\n    color: #8a8a99;\n    font-size: 14px;\n    line-height: 1.55;\n  }\n  .sc-rules__cta-row {\n    margin-top: 40px;\n    padding-top: 28px;\n    border-top: 1px solid #1c1c24;\n    display: flex;\n    flex-direction: column;\n    gap: 16px;\n  }\n  .sc-rules__cta-quote {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-size: 18px;\n    line-height: 1.45;\n    color: #d9d9e0;\n    max-width: 440px;\n  }\n  .sc-rules__cta-buttons {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 12px;\n  }\n  .sc-rules__cta-primary {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    border-radius: 9999px;\n    background: #fbbf24;\n    color: #07070b;\n    padding: 8px 8px 8px 18px;\n    font-size: 14px;\n    font-weight: 500;\n    text-decoration: none;\n    transition: background 200ms ease;\n  }\n  .sc-rules__cta-primary:hover {\n    background: #fcd34d;\n  }\n  .sc-rules__cta-primary-arrow {\n    display: grid;\n    place-items: center;\n    height: 28px;\n    width: 28px;\n    border-radius: 9999px;\n    background: #07070b;\n    color: #fbbf24;\n  }\n  .sc-rules__cta-secondary {\n    display: inline-flex;\n    align-items: center;\n    border-radius: 9999px;\n    border: 1px solid #2e2e38;\n    color: #eeeef1;\n    padding: 10px 18px;\n    font-size: 14px;\n    text-decoration: none;\n    transition: background 200ms ease;\n  }\n  .sc-rules__cta-secondary:hover {\n    background: #0e0e14;\n  }\n  @media (min-width: 640px) {\n    .sc-rules__card { padding: 64px 40px; }\n    .sc-rules__title { font-size: 40px; }\n    .sc-rules__grid { grid-template-columns: repeat(2, 1fr); gap: 32px; }\n  }\n  @media (min-width: 900px) {\n    .sc-rules__card { padding: 80px 56px; border-radius: 32px; }\n    .sc-rules__title { font-size: 56px; }\n    .sc-rules__cta-row {\n      flex-direction: row;\n      align-items: center;\n      justify-content: space-between;\n    }\n  }\n</style>\n<section class=\"sc-rules\">\n<div class=\"sc-rules__inner\">\n<div class=\"sc-rules__card\">\n<span aria-hidden=\"true\" class=\"sc-rules__halo\"></span>\n<div class=\"sc-rules__head\">\n<div class=\"sc-rules__rule\">\n<span class=\"sc-rules__rule-line\"></span>\n<span>House rules</span>\n</div>\n<h2 class=\"sc-rules__title\">\n          Four lines.\n          <em>Read them at the door.</em>\n</h2>\n</div>\n<div class=\"sc-rules__grid\"><div class=\"sc-rule\">\n<div class=\"sc-rule__head\">\n<span class=\"sc-rule__num\">01\n                </span>\n<h3 class=\"sc-rule__title\">No stock. No templates.</h3>\n</div>\n<p class=\"sc-rule__body\">Every image is original. Crafted by filmmakers, not scraped from a stock library.</p>\n</div><div class=\"sc-rule\">\n<div class=\"sc-rule__head\">\n<span class=\"sc-rule__num\">02\n                </span>\n<h3 class=\"sc-rule__title\">Members only.</h3>\n</div>\n<p class=\"sc-rule__body\">One subscription. Full access to every drop, every category, every aspect ratio.</p>\n</div><div class=\"sc-rule\">\n<div class=\"sc-rule__head\">\n<span class=\"sc-rule__num\">03\n                </span>\n<h3 class=\"sc-rule__title\">New drops, every month.</h3>\n</div>\n<p class=\"sc-rule__body\">Curated releases on theme. Fresh, ready to use, never bloated.</p>\n</div><div class=\"sc-rule\">\n<div class=\"sc-rule__head\">\n<span class=\"sc-rule__num\">04\n                </span>\n<h3 class=\"sc-rule__title\">Commercial license, included.</h3>\n</div>\n<p class=\"sc-rule__body\">Use the imagery in campaigns, decks, ads, launches. Full rights baked in.</p>\n</div></div>\n<div class=\"sc-rules__cta-row\">\n<p class=\"sc-rules__cta-quote\">\n          If the rules sound right, the door is open.\n        </p>\n<div class=\"sc-rules__cta-buttons\">\n<a class=\"sc-rules__cta-primary\" href=\"https://www.shotclubai.com/get-started?ref=moonbear&amp;utm_source=moonbear\">\n            Apply for membership\n            <span aria-hidden=\"true\" class=\"sc-rules__cta-primary-arrow\">→</span>\n</a><a class=\"sc-rules__cta-secondary\" href=\"https://shotclubai.com/pricing\">\n              See the dues\n            </a></div>\n</div>\n</div>\n</div>\n</section>\n</section>"
  }
