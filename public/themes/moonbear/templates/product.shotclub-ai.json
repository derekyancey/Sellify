   "html": "<section class=\"shopify-section sc-hero-section\" id=\"shopify-section-template--23043659989235__shotclub_hero_NgHnQX\"><style data-shopify=\"\">\n  .sc-hero {\n    position: relative;\n    overflow: hidden;\n    padding: 64px 20px 80px;\n    background: #ffffff;\n    color: #0e0e14;\n    border-bottom: 1px solid #eeeef1;\n    font-family: 'Inter', system-ui, -apple-system, sans-serif;\n  }\n  .sc-hero__halo,\n  .sc-hero__halo-2 {\n    pointer-events: none;\n    position: absolute;\n    border-radius: 9999px;\n    filter: blur(80px);\n  }\n  .sc-hero__halo {\n    top: 120px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 520px;\n    height: 420px;\n    background: rgba(252, 211, 77, 0.5);\n  }\n  .sc-hero__halo-2 {\n    top: -90px;\n    right: -180px;\n    width: 300px;\n    height: 300px;\n    background: rgba(235, 232, 255, 0.6);\n  }\n  .sc-hero__inner {\n    position: relative;\n    max-width: 1180px;\n    margin: 0 auto;\n  }\n  .sc-hero__rule {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #60606e;\n    font-weight: 500;\n  }\n  .sc-hero__rule-line {\n    display: inline-block;\n    width: 24px;\n    height: 1px;\n    background: #b6b6c2;\n  }\n  .sc-hero__rule-dot {\n    color: #b6b6c2;\n  }\n  .sc-hero__head {\n    text-align: center;\n    max-width: 640px;\n    margin: 0 auto;\n  }\n  .sc-hero__title {\n    margin: 24px 0 0;\n    font-size: 34px;\n    line-height: 1.06;\n    letter-spacing: -0.012em;\n    font-weight: 500;\n    color: #0e0e14;\n  }\n  .sc-hero__title em {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-weight: 400;\n    color: #2e2e38;\n  }\n  .sc-hero__title .sc-period {\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-weight: 400;\n    color: #b6b6c2;\n  }\n  .sc-hero__sub {\n    margin: 18px auto 0;\n    max-width: 460px;\n    font-size: 16px;\n    line-height: 1.55;\n    color: #434350;\n  }\n  .sc-hero__form-wrap {\n    position: relative;\n    margin: 36px auto 0;\n    max-width: 440px;\n  }\n  .sc-hero__plate {\n    display: none;\n  }\n  .sc-hero__form {\n    position: relative;\n    border-radius: 16px;\n    border: 1px solid #d9d9e0;\n    background: #ffffff;\n    box-shadow: 0 30px 60px -24px rgba(14, 14, 20, 0.18);\n    padding: 22px 22px 22px;\n  }\n  .sc-hero__form-tag {\n    position: absolute;\n    top: -12px;\n    left: 20px;\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    background: #ffffff;\n    border: 1px solid #d9d9e0;\n    border-radius: 9999px;\n    padding: 4px 10px;\n    font-size: 9px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #60606e;\n    font-weight: 500;\n  }\n  .sc-hero__form-tag::before {\n    content: '';\n    height: 6px;\n    width: 6px;\n    border-radius: 9999px;\n    background: #fbbf24;\n  }\n  .sc-hero__field-label {\n    display: block;\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #60606e;\n    font-weight: 500;\n    margin: 8px 0 6px;\n  }\n  .sc-hero__input {\n    width: 100%;\n    height: 48px;\n    padding: 0 14px;\n    border-radius: 12px;\n    border: 1px solid #d9d9e0;\n    background: #ffffff;\n    font-size: 16px;\n    color: #0e0e14;\n    box-sizing: border-box;\n  }\n  .sc-hero__input:focus {\n    outline: none;\n    border-color: #fbbf24;\n    box-shadow: 0 0 0 3px rgba(252, 191, 36, 0.4);\n  }\n  .sc-hero__cta {\n    width: 100%;\n    margin-top: 12px;\n    min-height: 48px;\n    border: 0;\n    cursor: pointer;\n    background: #0e0e14;\n    color: #ffffff;\n    border-radius: 9999px;\n    padding: 6px 8px 6px 20px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 8px;\n    font-size: 15px;\n    font-weight: 500;\n    font-family: inherit;\n  }\n  .sc-hero__cta:hover {\n    background: #1c1c24;\n  }\n  .sc-hero__cta-arrow {\n    display: grid;\n    place-items: center;\n    height: 32px;\n    width: 32px;\n    border-radius: 9999px;\n    background: #fbbf24;\n    color: #07070b;\n  }\n  .sc-hero__fineprint {\n    margin-top: 10px;\n    text-align: center;\n    font-family: 'Fraunces', 'Georgia', serif;\n    font-style: italic;\n    font-size: 11px;\n    line-height: 1.5;\n    color: #60606e;\n  }\n  .sc-hero__fineprint a {\n    color: #0e0e14;\n    font-style: normal;\n    font-family: inherit;\n  }\n  .sc-hero__trust {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 12px;\n    margin: 36px auto 0;\n    max-width: 600px;\n    text-align: center;\n  }\n  .sc-hero__trust-label {\n    font-size: 9px;\n    text-transform: uppercase;\n    letter-spacing: 0.22em;\n    color: #60606e;\n    font-weight: 500;\n  }\n  .sc-hero__trust-line {\n    margin-top: 6px;\n    font-size: 12px;\n    line-height: 1.35;\n    color: #1c1c24;\n  }\n  @media (min-width: 640px) {\n    .sc-hero { padding-left: 32px; padding-right: 32px; }\n    .sc-hero__title { font-size: 56px; }\n    .sc-hero__sub { font-size: 18px; }\n    .sc-hero__plate {\n      display: block;\n      position: absolute;\n      pointer-events: none;\n    }\n    .sc-hero__plate--member {\n      left: -64px;\n      top: -8px;\n      transform: rotate(-6deg);\n      background: #ffffff;\n      border: 1px solid #eeeef1;\n      box-shadow: 0 1px 2px rgba(12,12,20,0.04), 0 8px 24px rgba(12,12,20,0.06);\n      border-radius: 14px;\n      padding: 8px 12px;\n    }\n    .sc-hero__plate--member-label {\n      font-size: 8px;\n      text-transform: uppercase;\n      letter-spacing: 0.22em;\n      color: #8a8a99;\n      font-weight: 500;\n    }\n    .sc-hero__plate--member-num {\n      font-family: 'Fraunces', 'Georgia', serif;\n      font-style: italic;\n      font-size: 22px;\n      color: #0e0e14;\n      line-height: 1;\n      margin-top: 2px;\n    }\n    .sc-hero__plate--seat {\n      right: -56px;\n      bottom: -8px;\n      transform: rotate(5deg);\n      background: #0e0e14;\n      color: #ffffff;\n      border-radius: 9999px;\n      padding: 6px 14px;\n      box-shadow: 0 12px 32px rgba(14,14,20,0.32);\n    }\n    .sc-hero__plate--seat-text {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      font-size: 9px;\n      text-transform: uppercase;\n      letter-spacing: 0.22em;\n      font-weight: 500;\n    }\n    .sc-hero__plate--seat-text::before {\n      content: '';\n      height: 6px;\n      width: 6px;\n      border-radius: 9999px;\n      background: #fcd34d;\n      animation: sc-pulse 2s infinite;\n    }\n    @keyframes sc-pulse {\n      0%, 100% { opacity: 1; }\n      50% { opacity: 0.4; }\n    }\n  }\n  @media (min-width: 768px) {\n    .sc-hero__title { font-size: 64px; }\n  }\n</style>\n<link href=\"https://fonts.googleapis.com\" rel=\"preconnect\"/>\n<link crossorigin=\"\" href=\"https://fonts.gstatic.com\" rel=\"preconnect\"/>\n<link href=\"https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,400;0,500;1,400;1,500&amp;family=Inter:wght@400;500&amp;display=swap\" rel=\"stylesheet\"/>\n<section class=\"sc-hero\">\n<span aria-hidden=\"true\" class=\"sc-hero__halo\"></span>\n<span aria-hidden=\"true\" class=\"sc-hero__halo-2\"></span>\n<div class=\"sc-hero__inner\">\n<div class=\"sc-hero__head\">\n<div class=\"sc-hero__rule\">\n<span class=\"sc-hero__rule-line\"></span>\n<span>Membership</span>\n<span class=\"sc-hero__rule-dot\">·</span>\n<span>By invitation, on demand</span>\n<span class=\"sc-hero__rule-line\"></span>\n</div>\n<h1 class=\"sc-hero__title\">\n        Apply for\n        <em>membership</em><span class=\"sc-period\">.</span>\n</h1>\n<p class=\"sc-hero__sub\">\n        The door opens at checkout. There's no free tier — your seat is held the moment your first payment clears.\n      </p>\n</div>\n<div class=\"sc-hero__form-wrap\"><div class=\"sc-hero__plate sc-hero__plate--member\">\n<div class=\"sc-hero__plate--member-label\">Member No.</div>\n<div class=\"sc-hero__plate--member-num\">___</div>\n</div>\n<div class=\"sc-hero__plate sc-hero__plate--seat\">\n<span class=\"sc-hero__plate--seat-text\">Now seating</span>\n</div>\n<form action=\"https://www.shotclubai.com/pricing?utm_source=moonbear.shop&amp;utm_medium=referral\" class=\"sc-hero__form\" data-sc-hero-form=\"\" method=\"get\">\n<div class=\"sc-hero__form-tag\">Application</div>\n<label>\n<span class=\"sc-hero__field-label\">Email for receipt &amp; sign-in</span>\n<input autocomplete=\"email\" class=\"sc-hero__input\" inputmode=\"email\" name=\"email\" placeholder=\"you@studio.com\" required=\"\" type=\"email\"/>\n</label>\n<input name=\"ref\" type=\"hidden\" value=\"moonbear\"/>\n<input name=\"utm_source\" type=\"hidden\" value=\"moonbear\"/>\n<button class=\"sc-hero__cta\" type=\"submit\">\n<span>Continue — apply for membership</span>\n<span aria-hidden=\"true\" class=\"sc-hero__cta-arrow\">→</span>\n</button>\n<p class=\"sc-hero__fineprint\">\n          Account opens at checkout. Cancel anytime.\n          <a href=\"https://shotclubai.com/license\" rel=\"noopener\" target=\"_blank\">License terms</a>.\n        </p>\n</form>\n</div>\n<ul class=\"sc-hero__trust\"><li>\n<div class=\"sc-hero__trust-label\">Cancel anytime</div>\n<div class=\"sc-hero__trust-line\">No multi-month lock-in.</div>\n</li><li>\n<div class=\"sc-hero__trust-label\">Commercial use</div>\n<div class=\"sc-hero__trust-line\">Included with every plan.</div>\n</li><li>\n<div class=\"sc-hero__trust-label\">Stripe checkout</div>\n<div class=\"sc-hero__trust-line\">We never see your card.</div>\n</li></ul>\n</div>\n</section>\n</section>"
