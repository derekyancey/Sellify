{
  "projectId": "YOUR_APPWRITE_PROJECT_ID",
  "projectName": "Yancey",
  "functions": [
    {
      "$id": "site-ops",
      "name": "site-ops",
      "runtime": "python-3.12",
      "path": "appwrite/functions/site-ops",
      "entrypoint": "src/main.py",
      "commands": "pip install -r requirements.txt",
      "execute": [
        "team:admins"
      ],
      "events": [],
      "schedule": "",
      "timeout": 30,
      "enabled": true,
      "logging": true,
      "scopes": [
        "teams.read",
        "sites.read",
        "sites.write",
        "rules.read",
        "rules.write"
      ]
    },
    {
      "$id": "checkout",
      "name": "checkout",
      "runtime": "python-3.12",
      "path": "appwrite/functions/checkout",
      "entrypoint": "src/main.py",
      "commands": "pip install -r requirements.txt",
      "execute": [
        "any"
      ],
      "events": [],
      "schedule": "",
      "timeout": 30,
      "enabled": true,
      "logging": true,
      "scopes": [
        "rows.read",
        "rows.write"
      ]
    },
    {
      "$id": "automations",
      "name": "automations",
      "runtime": "python-3.12",
      "path": "appwrite/functions/automations",
      "entrypoint": "src/main.py",
      "commands": "pip install -r requirements.txt",
      "execute": [
        "team:admins"
      ],
      "events": [],
      "schedule": "*/30 * * * *",
      "timeout": 30,
      "enabled": true,
      "logging": true,
      "scopes": [
        "rows.read",
        "rows.write"
      ]
    }
  ],
  "sites": [
    {
      "$id": "yancey",
      "name": "Yancey",
      "framework": "vite",
      "adapter": "static",
      "buildRuntime": "node-22",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "./dist",
      "fallbackFile": "index.html",
      "path": ".",
      "enabled": true,
      "logging": true,
      "timeout": 30
    }
  ]
}
