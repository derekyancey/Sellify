# Leave VITE_APPWRITE_PROJECT_ID empty to run in demo mode (sample data, no backend).
# Yancey is hosted at https://realniggafoods.com (add it and www. as Web platforms in Appwrite).
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=yancey
VITE_APPWRITE_FUNCTION_ID=site-ops
VITE_APPWRITE_BUCKET_ID=files
VITE_APPWRITE_AUTOMATIONS_FUNCTION_ID=automations
# The checkout function's public domain (Appwrite → Functions → checkout → Domains); used for the product feed URL
VITE_CHECKOUT_PUBLIC_URL=
# Optional: a browser-restricted Google API key for PageSpeed Insights (works without one, but rate-limited)
VITE_PAGESPEED_API_KEY=
